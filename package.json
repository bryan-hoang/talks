{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rimraf dist/ && pnpm --recursive run build",
    "dev": "jiti scripts/picker.ts dev",
    "lint": "pnpm run lint:code && pnpm run lint:format && pnpm run lint:content",
    "lint:code": "oxlint . && eslint --config eslint.oxlint-residual.config.js --no-error-on-unmatched-pattern \"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}\"",
    "lint:format": "oxfmt --check --no-error-on-unmatched-pattern \"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}\" \"**/*.{md,markdown,mdx,yaml,yml,toml,css,scss,less}\" .oxfmtrc.json .oxlintrc.json",
    "lint:content": "eslint --cache --cache-strategy=content --cache-location=.cache/eslint/ --no-error-on-unmatched-pattern \"**/*.{md,markdown,mdx,yaml,yml,toml,vue}\""
  },
  "dependencies": {
    "@slidev/cli": "latest",
    "@slidev/theme-default": "latest",
    "rimraf": "6.1.3",
    "slidev-theme-dracula": "0.2.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@e18e/eslint-plugin": "0.8.1",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.10.6",
    "@typescript-eslint/parser": "8.71.1",
    "@vitest/eslint-plugin": "1.6.27",
    "consola": "3.4.2",
    "eslint": "10.12.0",
    "eslint-config-flat-gitignore": "2.4.0",
    "eslint-plugin-antfu": "3.2.3",
    "eslint-plugin-command": "4.0.0",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-jsdoc": "64.5.4",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "execa": "10.1.0",
    "jiti": "2.7.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "playwright-chromium": "1.64.0",
    "prettier-plugin-slidev": "1.0.5"
  },
  "packageManager": "pnpm@12.12.0"
}
