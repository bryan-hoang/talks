{
  "ignorePatterns": ["**/src/slides.md"],
  "overrides": [
    {
      "files": [
        "**/*.js",
        "**/*.mjs",
        "**/*.cjs",
        "**/*.jsx",
        "**/*.ts",
        "**/*.mts",
        "**/*.cts",
        "**/*.tsx"
      ],
      "options": {
        "arrowParens": "avoid",
        "sortImports": true,
        "singleQuote": true
      }
    },
    {
      "files": ["**/*.md", "**/*.markdown", "**/*.mdx"],
      "options": {
        "embeddedLanguageFormatting": "off",
        "printWidth": 120,
        "proseWrap": "always"
      }
    },
    {
      "files": ["pnpm-workspace.yaml"],
      "options": {
        "singleQuote": true
      }
    }
  ]
}
